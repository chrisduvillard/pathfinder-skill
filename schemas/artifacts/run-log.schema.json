{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathfinder.local/schemas/artifacts/run-log.schema.json",
  "title": "Pathfinder Run Log",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mission_id", "attempt_id", "binding_id", "runtime_boundary_id", "commands", "binding_status", "verification", "publication", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "mission_id": {"type": "string", "pattern": "^mission_[a-z0-9][a-z0-9_-]{7,63}$"},
    "attempt_id": {"type": ["string", "null"], "pattern": "^attempt_[a-z0-9][a-z0-9_-]{7,63}$"},
    "binding_id": {"type": "string", "pattern": "^binding_[a-z0-9][a-z0-9_-]{7,63}$"},
    "runtime_boundary_id": {"type": ["string", "null"], "pattern": "^boundary_[a-z0-9][a-z0-9_-]{7,63}$"},
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "binding_status": {"enum": ["matched", "missing", "stale-objective", "mismatched", "not-run"]},
    "verification": {"enum": ["not-run", "passed", "failed", "blocked"]},
    "publication": {"enum": ["not-requested", "local-only", "pending", "awaiting-review", "failed"]},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "argv_sha256", "environment_policy_sha256", "working_directory", "timeout_seconds", "started_at", "finished_at", "exit_status", "output_artifact"],
      "properties": {
        "command_id": {"type": "string", "pattern": "^command_[a-z0-9][a-z0-9_-]{7,63}$"},
        "argv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "working_directory": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "exit_status": {"type": ["integer", "null"]},
        "output_artifact": {"type": ["string", "null"]}
      }
    }
  }
}
