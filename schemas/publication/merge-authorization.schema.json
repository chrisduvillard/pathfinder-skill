{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathfinder.local/schemas/publication/merge-authorization.schema.json",
  "title": "Pathfinder Current-Run Merge Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "merge_authorization_id", "authority", "explicit_request", "mission", "policy", "repository", "budget", "merge_method", "issued_at", "expires_at", "authorization_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "merge_authorization_id": {"type": "string", "pattern": "^merge_authorization_[a-z0-9][a-z0-9_-]{7,63}$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source", "authenticated", "issuer"],
      "properties": {
        "kind": {"const": "conditional-merge"},
        "source": {"enum": ["current-user-turn", "host-approval-store"]},
        "authenticated": {"const": true},
        "issuer": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{2,127}$"}
      }
    },
    "explicit_request": {"const": true},
    "mission": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_id", "binding_id", "mission_authorization_id", "goal_scope"],
      "properties": {
        "mission_id": {"type": "string", "pattern": "^mission_[a-z0-9][a-z0-9_-]{7,63}$"},
        "binding_id": {"type": "string", "pattern": "^binding_[a-z0-9][a-z0-9_-]{7,63}$"},
        "mission_authorization_id": {"type": "string", "pattern": "^authorization_[a-z0-9][a-z0-9_-]{7,63}$"},
        "goal_scope": {"const": "single-goal"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_sha256"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^merge_policy_[a-z0-9][a-z0-9_-]{7,63}$"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "node_id", "owner", "name", "base_branch"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "node_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{4,128}={0,2}$"},
        "owner": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"},
        "base_branch": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._/-]{0,253}[A-Za-z0-9])?$"}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_goals", "max_parallel_goals", "max_pull_requests", "max_merge_intents", "remaining_merge_intents", "same_repository_pull_request"],
      "properties": {
        "max_goals": {"const": 1},
        "max_parallel_goals": {"const": 1},
        "max_pull_requests": {"const": 1},
        "max_merge_intents": {"const": 1},
        "remaining_merge_intents": {"const": 1},
        "same_repository_pull_request": {"const": true}
      }
    },
    "merge_method": {"const": "squash"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authorization_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
