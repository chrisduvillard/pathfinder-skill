{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathfinder.local/schemas/publication/merge-credential-receipt.schema.json",
  "title": "Pathfinder Authenticated Merge Credential Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "credential_receipt_id", "source", "credential_id", "kind", "boundary", "permissions", "repository_selection", "repository_ids", "app_id", "app_node_id", "installation_id", "installation_account_id", "actor_id", "actor_node_id", "login", "issued_at", "expires_at", "verified_at", "suspended", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "credential_receipt_id": {"type": "string", "pattern": "^merge_credential_receipt_[a-z0-9][a-z0-9_-]{7,63}$"},
    "source": {"const": "authenticated-host-credential-store"},
    "credential_id": {"type": "string", "pattern": "^merge_credential_[a-z0-9][a-z0-9_-]{7,63}$"},
    "kind": {"const": "installation-token"},
    "boundary": {"const": "github-merge-executor"},
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["contents", "metadata", "pull_requests"],
      "properties": {"contents": {"const": "write"}, "metadata": {"const": "read"}, "pull_requests": {"const": "read"}}
    },
    "repository_selection": {"const": "selected"},
    "repository_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "app_id": {"type": "integer", "minimum": 1},
    "app_node_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{4,128}={0,2}$"},
    "installation_id": {"type": "integer", "minimum": 1},
    "installation_account_id": {"type": "integer", "minimum": 1},
    "actor_id": {"type": "integer", "minimum": 1},
    "actor_node_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{4,128}={0,2}$"},
    "login": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?\\[bot\\]$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": "string", "format": "date-time"},
    "suspended": {"const": false},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
