{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathfinder.local/schemas/publication/merge-evidence.schema.json",
  "title": "Pathfinder Conditional Merge Evidence",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "observation", "repository", "actor", "pull_request", "bindings", "diff", "pagination", "classic_protection", "active_rules", "source_rulesets", "bypass_memberships", "reviews", "review_requests", "review_threads", "checks", "mergeability", "unsupported_reasons", "unknown_reasons", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "pattern": "^merge_evidence_[a-z0-9][a-z0-9_-]{7,63}$"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["rest_api_version", "graphql_query_sha256", "policy_read", "request_ids_sha256", "requests", "unknown_payloads_sha256", "observed_at", "completed_at", "expires_at", "collection_complete"],
      "properties": {
        "rest_api_version": {"const": "2026-03-10"},
        "graphql_query_sha256": {"const": "dcb086d66394c7380a8933204c23d7aac3bde96762d05e69c5cc37edb770fdb5"},
        "policy_read": {"$ref": "#/$defs/policyRead"},
        "request_ids_sha256": {"$ref": "#/$defs/sha256"},
        "requests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/responseAudit"}},
        "unknown_payloads_sha256": {"$ref": "#/$defs/nullableSha256"},
        "observed_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "collection_complete": {"type": "boolean"}
      }
    },
    "repository": {"$ref": "#/$defs/repository"},
    "actor": {"$ref": "#/$defs/actor"},
    "pull_request": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "node_id", "number", "state", "draft", "same_repository", "author_id", "last_pusher_id", "head_repository_id", "head_repository_node_id", "head_ref", "head_sha", "base_repository_id", "base_repository_node_id", "base_ref", "base_sha", "merge_commit_sha", "merged_at", "merged_by"],
      "properties": {
        "id": {"type": "integer", "minimum": 1}, "node_id": {"$ref": "#/$defs/nodeId"},
        "number": {"type": "integer", "minimum": 1}, "state": {"enum": ["open", "closed", "merged"]},
        "draft": {"type": "boolean"}, "same_repository": {"type": "boolean"},
        "author_id": {"type": "integer", "minimum": 1}, "last_pusher_id": {"type": "integer", "minimum": 1},
        "head_repository_id": {"type": "integer", "minimum": 1}, "head_repository_node_id": {"$ref": "#/$defs/nodeId"},
        "head_ref": {"$ref": "#/$defs/ref"}, "head_sha": {"$ref": "#/$defs/commit"},
        "base_repository_id": {"type": "integer", "minimum": 1}, "base_repository_node_id": {"$ref": "#/$defs/nodeId"},
        "base_ref": {"$ref": "#/$defs/ref"}, "base_sha": {"$ref": "#/$defs/commit"},
        "merge_commit_sha": {"$ref": "#/$defs/nullableCommit"},
        "merged_at": {"type": ["string", "null"], "format": "date-time"},
        "merged_by": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/mergedBy"}]}
      }
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_sha256", "merge_authorization_id", "authorization_sha256", "mission_id", "binding_id", "mission_authorization_id", "protected_policy_sha256"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^merge_policy_[a-z0-9][a-z0-9_-]{7,63}$"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "merge_authorization_id": {"type": "string", "pattern": "^merge_authorization_[a-z0-9][a-z0-9_-]{7,63}$"},
        "authorization_sha256": {"$ref": "#/$defs/sha256"},
        "mission_id": {"type": "string", "pattern": "^mission_[a-z0-9][a-z0-9_-]{7,63}$"},
        "binding_id": {"type": "string", "pattern": "^binding_[a-z0-9][a-z0-9_-]{7,63}$"},
        "mission_authorization_id": {"type": "string", "pattern": "^authorization_[a-z0-9][a-z0-9_-]{7,63}$"},
        "protected_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "diff": {
      "type": "object", "additionalProperties": false,
      "required": ["diff_sha256", "changed_files_sha256", "object_evidence", "changed_files", "changed_file_count", "total_line_changes", "patch_bytes", "protected_categories", "special_files"],
      "properties": {
        "diff_sha256": {"$ref": "#/$defs/sha256"}, "changed_files_sha256": {"$ref": "#/$defs/sha256"},
        "object_evidence": {"$ref": "#/$defs/objectEvidence"},
        "changed_files": {"type": "array", "maxItems": 3000, "uniqueItems": true, "items": {"$ref": "#/$defs/changedFile"}},
        "changed_file_count": {"type": "integer", "minimum": 0}, "total_line_changes": {"type": "integer", "minimum": 0},
        "patch_bytes": {"type": "integer", "minimum": 0},
        "protected_categories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}},
        "special_files": {"type": "array", "uniqueItems": true, "items": {"enum": ["symlink", "submodule", "binary", "workflow", "codeowners", "policy"]}}
      }
    },
    "pagination": {
      "type": "object", "additionalProperties": false,
      "required": ["pull_files", "active_rules", "source_rulesets", "bypass_actors", "bypass_memberships", "reviews", "review_requests", "review_threads", "check_runs", "commit_statuses", "deployments"],
      "properties": {
        "pull_files": {"$ref": "#/$defs/page"}, "active_rules": {"$ref": "#/$defs/page"},
        "source_rulesets": {"$ref": "#/$defs/page"}, "bypass_actors": {"$ref": "#/$defs/page"}, "bypass_memberships": {"$ref": "#/$defs/page"},
        "reviews": {"$ref": "#/$defs/page"}, "review_requests": {"$ref": "#/$defs/page"},
        "review_threads": {"$ref": "#/$defs/page"}, "check_runs": {"$ref": "#/$defs/page"},
        "commit_statuses": {"$ref": "#/$defs/page"}, "deployments": {"$ref": "#/$defs/page"}
      }
    },
    "classic_protection": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "settings_sha256", "required_review_count", "required_checks", "bypass_visibility", "bypass_actor_keys", "bypass_actor_metadata", "enforce_admins", "conversation_resolution_required", "last_push_approval_required", "dismiss_stale_reviews", "code_owner_review_required", "required_linear_history", "required_signatures", "restrictions_present", "dismissal_restrictions_present"],
      "properties": {
        "status": {"enum": ["present", "absent", "unknown"]}, "settings_sha256": {"$ref": "#/$defs/nullableSha256"},
        "required_review_count": {"type": ["integer", "null"], "minimum": 0},
        "required_checks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/checkIdentity"}},
        "bypass_visibility": {"enum": ["complete", "not-applicable", "unknown"]},
        "bypass_actor_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/actorKey"}},
        "bypass_actor_metadata": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/classicBypassActorMetadata"}},
        "enforce_admins": {"type": ["boolean", "null"]},
        "conversation_resolution_required": {"type": ["boolean", "null"]},
        "last_push_approval_required": {"type": ["boolean", "null"]},
        "dismiss_stale_reviews": {"type": ["boolean", "null"]},
        "code_owner_review_required": {"type": ["boolean", "null"]},
        "required_linear_history": {"type": ["boolean", "null"]},
        "required_signatures": {"type": ["boolean", "null"]},
        "restrictions_present": {"type": ["boolean", "null"]},
        "dismissal_restrictions_present": {"type": ["boolean", "null"]}
      }
    },
    "active_rules": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ruleset_id", "source_type", "source_id", "rule_type", "parameters_sha256", "approval_count", "allowed_merge_methods", "code_owner_review_required", "required_checks", "strict"],
        "properties": {
          "ruleset_id": {"type": "integer", "minimum": 1}, "source_type": {"enum": ["Repository", "Organization", "Enterprise"]},
          "source_id": {"type": "integer", "minimum": 1},
          "rule_type": {"enum": ["pull_request", "required_status_checks", "required_linear_history", "merge_queue", "required_deployments", "required_signatures", "code_scanning", "code_quality", "file_path_restriction", "max_file_size"]},
          "parameters_sha256": {"$ref": "#/$defs/sha256"}, "approval_count": {"type": ["integer", "null"], "minimum": 0},
          "allowed_merge_methods": {"type": "array", "uniqueItems": true, "items": {"enum": ["merge", "squash", "rebase"]}},
          "code_owner_review_required": {"type": ["boolean", "null"]},
          "required_checks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/checkIdentity"}},
          "strict": {"type": ["boolean", "null"]}
        }
      }
    },
    "source_rulesets": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source_type", "source_id", "enforcement", "conditions_sha256", "rules_sha256", "active_rules_sha256", "updated_at", "bypass_visibility", "bypass_actor_keys", "bypass_actor_metadata"],
        "properties": {
          "id": {"type": "integer", "minimum": 1}, "source_type": {"enum": ["Repository", "Organization", "Enterprise"]},
          "source_id": {"type": "integer", "minimum": 1}, "enforcement": {"enum": ["active", "evaluate", "disabled"]},
          "conditions_sha256": {"$ref": "#/$defs/sha256"}, "rules_sha256": {"$ref": "#/$defs/sha256"}, "active_rules_sha256": {"$ref": "#/$defs/sha256"},
          "updated_at": {"type": "string", "format": "date-time"},
          "bypass_visibility": {"enum": ["complete", "unknown"]},
          "bypass_actor_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/rulesetBypassActorKey"}},
          "bypass_actor_metadata": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/rulesetBypassActorMetadata"}}
        }
      }
    },
    "bypass_memberships": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/bypassMembership"}},
    "reviews": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/review"}},
    "review_requests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reviewRequest"}},
    "review_threads": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/thread"}},
    "checks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/check"}},
    "mergeability": {
      "type": "object", "additionalProperties": false,
      "required": ["mergeable", "merge_state_status", "review_decision", "queue_entry", "required_sha"],
      "properties": {
        "mergeable": {"enum": ["MERGEABLE", "CONFLICTING", "UNKNOWN"]},
        "merge_state_status": {"enum": ["BEHIND", "BLOCKED", "CLEAN", "DIRTY", "DRAFT", "HAS_HOOKS", "UNKNOWN", "UNSTABLE"]},
        "review_decision": {"enum": ["APPROVED", "CHANGES_REQUESTED", "REVIEW_REQUIRED", "UNKNOWN"]},
        "queue_entry": {"type": "boolean"}, "required_sha": {"$ref": "#/$defs/commit"}
      }
    },
    "unsupported_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["merge-queue-required", "unsupported-required-deployments", "unsupported-required-signatures", "unsupported-code-scanning", "unsupported-code-quality", "unsupported-file-restriction", "unsupported-metadata-restriction", "unsupported-active-rule"]}},
    "unknown_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["api-version-unknown", "pagination-incomplete", "classic-protection-unknown", "ruleset-evidence-incomplete", "bypass-visibility-unknown", "actor-identity-unknown", "review-state-unknown", "check-evidence-incomplete", "merge-state-unknown", "diff-incomplete", "field-unknown"]}},
    "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nullableCommit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "nodeId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{4,128}={0,2}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._/-]{0,253}[A-Za-z0-9])?$"},
    "actorKey": {"type": "string", "pattern": "^(User|Team|Integration):[1-9][0-9]*$"},
    "rulesetBypassActorKey": {"type": "string", "pattern": "^(?:(?:User|Team|RepositoryRole|Integration):[1-9][0-9]*|(?:OrganizationAdmin|DeployKey):all):(always|pull_request|exempt)$"},
    "classicBypassActorMetadata": {"type": "object", "additionalProperties": false, "required": ["key", "actor_name"], "properties": {"key": {"$ref": "#/$defs/actorKey"}, "actor_name": {"$ref": "#/$defs/nullableActorName"}}},
    "rulesetBypassActorMetadata": {"type": "object", "additionalProperties": false, "required": ["key", "actor_name"], "properties": {"key": {"$ref": "#/$defs/rulesetBypassActorKey"}, "actor_name": {"$ref": "#/$defs/nullableActorName"}}},
    "nullableActorName": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,99}$"},
    "responseAudit": {"type": "object", "additionalProperties": false, "required": ["surface", "request_id", "etag", "observed_at"], "dependentRequired": {"target": ["status", "permission_qualified"], "status": ["target", "permission_qualified"], "permission_qualified": ["target", "status"]}, "properties": {"surface": {"enum": ["repository", "actor", "pull-request", "graphql-pull-request", "refs", "changed-files", "classic-protection", "active-rules", "source-rulesets", "bypass-actors", "bypass-memberships", "reviews", "review-requests", "review-threads", "check-runs", "commit-statuses", "deployments", "merged-state"]}, "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"}, "etag": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}, "observed_at": {"type": "string", "format": "date-time"}, "target": {"type": "string", "pattern": "^/(?:orgs|repos)/[A-Za-z0-9%_.~/-]{1,512}(?:\\?includes_parents=true)?$"}, "status": {"enum": [200, 403, 404]}, "permission_qualified": {"type": "boolean"}}},
    "policyRead": {"type": "object", "additionalProperties": false, "required": ["source", "receipt_id", "policy_id", "policy_sha256", "observed_at"], "properties": {"source": {"const": "host-policy-store"}, "receipt_id": {"type": "string", "pattern": "^policy_read_[a-z0-9][a-z0-9_-]{7,63}$"}, "policy_id": {"type": "string", "pattern": "^merge_policy_[a-z0-9][a-z0-9_-]{7,63}$"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "observed_at": {"type": "string", "format": "date-time"}}},
    "objectEvidence": {"type": "object", "additionalProperties": false, "required": ["source", "receipt_id", "files_sha256"], "properties": {"source": {"const": "authenticated-controller-git-diff"}, "receipt_id": {"type": "string", "pattern": "^object_evidence_[a-z0-9][a-z0-9_-]{7,63}$"}, "files_sha256": {"$ref": "#/$defs/sha256"}}},
    "checkIdentity": {"type": "object", "additionalProperties": false, "required": ["context", "app_id"], "properties": {"context": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()@,+-]{0,99}$"}, "app_id": {"type": "integer", "minimum": 1}}},
    "repository": {"type": "object", "additionalProperties": false, "required": ["id", "node_id", "owner", "name", "base_branch", "archived", "disabled", "merge_methods"], "properties": {"id": {"type": "integer", "minimum": 1}, "node_id": {"$ref": "#/$defs/nodeId"}, "owner": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"}, "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"}, "base_branch": {"$ref": "#/$defs/ref"}, "archived": {"type": "boolean"}, "disabled": {"type": "boolean"}, "merge_methods": {"type": "object", "additionalProperties": false, "required": ["squash", "merge_commit", "rebase"], "properties": {"squash": {"type": "boolean"}, "merge_commit": {"type": "boolean"}, "rebase": {"type": "boolean"}}}}},
    "actor": {"type": "object", "additionalProperties": false, "required": ["app_id", "app_node_id", "installation_id", "installation_account_id", "actor_id", "actor_node_id", "login", "administration_permission", "suspended", "bypass_assessment"], "properties": {"app_id": {"type": "integer", "minimum": 1}, "app_node_id": {"$ref": "#/$defs/nodeId"}, "installation_id": {"type": "integer", "minimum": 1}, "installation_account_id": {"type": "integer", "minimum": 1}, "actor_id": {"type": "integer", "minimum": 1}, "actor_node_id": {"$ref": "#/$defs/nodeId"}, "login": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?\\[bot\\]$"}, "administration_permission": {"enum": ["none", "read", "write"]}, "suspended": {"type": "boolean"}, "bypass_assessment": {"enum": ["no-match", "match", "unknown"]}}},
    "bypassMembership": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["policy_source", "ruleset_id", "actor_type", "actor_id", "bypass_mode", "subject_actor_id", "subject_login", "request_id", "organization_login", "team_slug", "membership_state", "membership_role"],
          "properties": {
            "policy_source": {"enum": ["classic-protection", "ruleset"]}, "ruleset_id": {"type": ["integer", "null"], "minimum": 1},
            "actor_type": {"const": "Team"}, "actor_id": {"type": "integer", "minimum": 1}, "bypass_mode": {"enum": ["always", "pull_request", "exempt", null]},
            "subject_actor_id": {"type": "integer", "minimum": 1}, "subject_login": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?\\[bot\\]$"}, "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"},
            "organization_login": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"}, "team_slug": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_-]{0,98}[A-Za-z0-9])?$"},
            "membership_state": {"enum": ["active", "absent", "pending"]}, "membership_role": {"enum": ["member", "maintainer", null]}
          },
          "allOf": [
            {"if": {"properties": {"policy_source": {"const": "classic-protection"}}}, "then": {"properties": {"ruleset_id": {"type": "null"}, "bypass_mode": {"type": "null"}}}},
            {"if": {"properties": {"policy_source": {"const": "ruleset"}}}, "then": {"properties": {"ruleset_id": {"type": "integer", "minimum": 1}, "bypass_mode": {"enum": ["always", "pull_request", "exempt"]}}}}
          ]
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["policy_source", "ruleset_id", "actor_type", "actor_id", "bypass_mode", "subject_actor_id", "subject_login", "request_id", "organization_login", "membership_state", "organization_role"],
          "properties": {
            "policy_source": {"const": "ruleset"}, "ruleset_id": {"type": "integer", "minimum": 1}, "actor_type": {"const": "OrganizationAdmin"}, "actor_id": {"type": "null"},
            "bypass_mode": {"enum": ["always", "pull_request", "exempt"]}, "subject_actor_id": {"type": "integer", "minimum": 1},
            "subject_login": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?\\[bot\\]$"}, "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"}, "organization_login": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
            "membership_state": {"enum": ["active", "absent", "pending"]}, "organization_role": {"enum": ["admin", "member", null]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["policy_source", "ruleset_id", "actor_type", "actor_id", "bypass_mode", "subject_actor_id", "subject_login", "request_id", "bypass_role_name", "subject_role_name", "subject_permission"],
          "properties": {
            "policy_source": {"const": "ruleset"}, "ruleset_id": {"type": "integer", "minimum": 1}, "actor_type": {"const": "RepositoryRole"}, "actor_id": {"type": "integer", "minimum": 1},
            "bypass_mode": {"enum": ["always", "pull_request", "exempt"]}, "subject_actor_id": {"type": "integer", "minimum": 1},
            "subject_login": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?\\[bot\\]$"}, "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"}, "bypass_role_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,99}$"},
            "subject_role_name": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,99}$"}, "subject_permission": {"enum": ["admin", "maintain", "write", "triage", "read", "none"]}
          }
        }
      ]
    },
    "page": {"type": "object", "additionalProperties": false, "required": ["complete", "pages", "items", "truncated", "last_cursor"], "properties": {"complete": {"type": "boolean"}, "pages": {"type": "integer", "minimum": 0}, "items": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}, "last_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["id", "actor_id", "actor_login", "actor_type", "repository_permission", "state", "commit_sha", "submitted_at", "author_association", "dismissed"], "properties": {"id": {"type": "integer", "minimum": 1}, "actor_id": {"type": "integer", "minimum": 1}, "actor_login": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\[bot\\])?$"}, "actor_type": {"enum": ["User", "Bot"]}, "repository_permission": {"enum": ["admin", "maintain", "write", "triage", "read", "none"]}, "state": {"enum": ["APPROVED", "CHANGES_REQUESTED", "COMMENTED", "DISMISSED", "PENDING"]}, "commit_sha": {"$ref": "#/$defs/commit"}, "submitted_at": {"type": "string", "format": "date-time"}, "author_association": {"enum": ["OWNER", "MEMBER", "COLLABORATOR", "CONTRIBUTOR", "FIRST_TIMER", "FIRST_TIME_CONTRIBUTOR", "NONE"]}, "dismissed": {"type": "boolean"}}},
    "reviewRequest": {"type": "object", "additionalProperties": false, "required": ["actor_id", "actor_type", "as_code_owner"], "properties": {"actor_id": {"type": "integer", "minimum": 1}, "actor_type": {"enum": ["User", "Team"]}, "as_code_owner": {"type": "boolean"}}},
    "thread": {"type": "object", "additionalProperties": false, "required": ["node_id", "resolved", "outdated"], "properties": {"node_id": {"$ref": "#/$defs/nodeId"}, "resolved": {"type": "boolean"}, "outdated": {"type": "boolean"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "source", "context", "app_id", "creator_actor_id", "creator_actor_type", "sha", "required", "status", "conclusion", "completed_at"], "properties": {"id": {"type": "integer", "minimum": 1}, "source": {"enum": ["check-run", "commit-status"]}, "context": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()@,+-]{0,99}$"}, "app_id": {"type": ["integer", "null"], "minimum": 1}, "creator_actor_id": {"type": "integer", "minimum": 1}, "creator_actor_type": {"enum": ["User", "Bot", "Integration"]}, "sha": {"$ref": "#/$defs/commit"}, "required": {"type": "boolean"}, "status": {"enum": ["queued", "in_progress", "completed"]}, "conclusion": {"enum": ["success", "failure", "neutral", "cancelled", "skipped", "timed_out", "action_required", "stale", null]}, "completed_at": {"type": ["string", "null"], "format": "date-time"}}},
    "changedFile": {"type": "object", "additionalProperties": false, "required": ["path", "previous_path", "status", "blob_sha", "additions", "deletions", "changes", "object_kind", "binary", "protected_categories", "special_files"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._@+() /-]{1,256}$"}, "previous_path": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._@+() /-]{1,256}$"}, "status": {"enum": ["added", "removed", "modified", "renamed", "copied", "changed", "unchanged"]}, "blob_sha": {"$ref": "#/$defs/commit"}, "additions": {"type": "integer", "minimum": 0}, "deletions": {"type": "integer", "minimum": 0}, "changes": {"type": "integer", "minimum": 0}, "object_kind": {"enum": ["regular-file", "symlink", "submodule"]}, "binary": {"type": "boolean"}, "protected_categories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}}, "special_files": {"type": "array", "uniqueItems": true, "items": {"enum": ["symlink", "submodule", "binary", "workflow", "codeowners", "policy"]}}}},
    "mergedBy": {"type": "object", "additionalProperties": false, "required": ["id", "node_id", "login"], "properties": {"id": {"type": "integer", "minimum": 1}, "node_id": {"$ref": "#/$defs/nodeId"}, "login": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\[bot\\])?$"}}}
  }
}
