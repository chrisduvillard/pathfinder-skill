{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathfinder.local/schemas/publication/merge-status-report.schema.json",
  "title": "Pathfinder Observation-only Merge Status Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "source", "state", "outcome", "eligible", "intent_ready", "execution_available", "writer_credential_loaded", "merge_intent_created", "publication", "inputs", "blocks", "required_approvals", "approval_actor_ids", "required_checks", "observed_at", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"enum": ["status", "evaluate"]},
    "source": {"const": "installed-host-read-only-composition"},
    "state": {"const": "awaiting-review"},
    "outcome": {"enum": ["unknown", "unsupported", "policy-blocked", "eligible"]},
    "eligible": {"type": "boolean"},
    "intent_ready": {"const": false},
    "execution_available": {"const": false},
    "writer_credential_loaded": {"const": false},
    "merge_intent_created": {"const": false},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_request_id", "publication_receipt_id", "receipt_sha256", "repository", "pull_request"],
      "properties": {
        "publication_request_id": {"type": "string", "pattern": "^publication_request_[a-z0-9][a-z0-9_-]{7,63}$"},
        "publication_receipt_id": {"type": "string", "pattern": "^publication_receipt_[a-z0-9][a-z0-9_-]{7,63}$"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "repository": {"$ref": "#/$defs/repository"},
        "pull_request": {"$ref": "#/$defs/pullRequest"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "authorization", "initial_evidence", "reread_evidence", "protected_policy"],
      "properties": {
        "policy": {"$ref": "#/$defs/policyInputBinding"},
        "authorization": {"$ref": "#/$defs/authorizationInputBinding"},
        "initial_evidence": {"$ref": "#/$defs/evidenceInputBinding"},
        "reread_evidence": {"$ref": "#/$defs/evidenceInputBinding"},
        "protected_policy": {"$ref": "#/$defs/protectedInputBinding"}
      }
    },
    "blocks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/block"}},
    "required_approvals": {"type": "integer", "minimum": 0},
    "approval_actor_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "required_checks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/check"}},
    "observed_at": {"type": "string", "format": "date-time"},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "eligible"}}, "required": ["outcome"]},
      "then": {"properties": {"eligible": {"const": true}, "blocks": {"maxItems": 0}}},
      "else": {"properties": {"eligible": {"const": false}, "blocks": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nodeId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{4,128}={0,2}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._/-]{0,253}[A-Za-z0-9])?$"},
    "inputBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "document_id", "document_sha256", "declared_sha256"],
      "properties": {
        "state": {"enum": ["present", "missing", "invalid", "shipped-baseline"]},
        "document_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "document_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "declared_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [{
        "if": {"properties": {"state": {"const": "missing"}}, "required": ["state"]},
        "then": {"properties": {
          "document_id": {"type": "null"},
          "document_sha256": {"type": "null"},
          "declared_sha256": {"type": "null"}
        }},
        "else": {"properties": {"document_sha256": {"$ref": "#/$defs/sha256"}}}
      }]
    },
    "installedInputBinding": {
      "allOf": [
        {"$ref": "#/$defs/inputBinding"},
        {"properties": {"state": {"enum": ["present", "missing", "invalid"]}}}
      ]
    },
    "policyInputBinding": {
      "allOf": [
        {"$ref": "#/$defs/installedInputBinding"},
        {
          "if": {"properties": {"state": {"const": "present"}}, "required": ["state"]},
          "then": {"properties": {
            "document_id": {"type": "string", "pattern": "^merge_policy_[a-z0-9][a-z0-9_-]{7,63}$"},
            "declared_sha256": {"$ref": "#/$defs/sha256"}
          }}
        }
      ]
    },
    "authorizationInputBinding": {
      "allOf": [
        {"$ref": "#/$defs/installedInputBinding"},
        {
          "if": {"properties": {"state": {"const": "present"}}, "required": ["state"]},
          "then": {"properties": {
            "document_id": {"type": "string", "pattern": "^merge_authorization_[a-z0-9][a-z0-9_-]{7,63}$"},
            "declared_sha256": {"$ref": "#/$defs/sha256"}
          }}
        }
      ]
    },
    "evidenceInputBinding": {
      "allOf": [
        {"$ref": "#/$defs/installedInputBinding"},
        {
          "if": {"properties": {"state": {"const": "present"}}, "required": ["state"]},
          "then": {"properties": {
            "document_id": {"type": "string", "pattern": "^merge_evidence_[a-z0-9][a-z0-9_-]{7,63}$"},
            "declared_sha256": {"$ref": "#/$defs/sha256"}
          }}
        }
      ]
    },
    "protectedInputBinding": {
      "allOf": [
        {"$ref": "#/$defs/inputBinding"},
        {"properties": {
          "state": {"enum": ["present", "invalid", "shipped-baseline"]},
          "declared_sha256": {"type": "null"}
        }},
        {
          "if": {
            "properties": {"state": {"enum": ["present", "shipped-baseline"]}},
            "required": ["state"]
          },
          "then": {"properties": {
            "document_id": {"type": "string", "pattern": "^protected-policy-[a-z0-9][a-z0-9-]{2,63}$"}
          }}
        }
      ]
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "node_id", "owner", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1}, "node_id": {"$ref": "#/$defs/nodeId"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 39},
        "name": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "pullRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "node_id", "number", "url", "head_ref", "head_sha", "base_ref", "base_sha"],
      "properties": {
        "id": {"type": "integer", "minimum": 1}, "node_id": {"$ref": "#/$defs/nodeId"},
        "number": {"type": "integer", "minimum": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "head_ref": {"$ref": "#/$defs/ref"}, "head_sha": {"$ref": "#/$defs/commit"},
        "base_ref": {"$ref": "#/$defs/ref"}, "base_sha": {"$ref": "#/$defs/commit"}
      }
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "surface", "detail"],
      "properties": {
        "code": {"enum": ["policy-missing", "authorization-missing", "evidence-missing", "protected-policy-missing", "input-invalid", "policy-expired", "authorization-expired", "evidence-expired", "identity-drift", "diff-drift", "api-version-unknown", "pagination-incomplete", "classic-protection-unknown", "ruleset-evidence-incomplete", "ruleset-drift", "bypass-visibility-unknown", "actor-identity-unknown", "review-state-unknown", "check-evidence-incomplete", "merge-state-unknown", "diff-incomplete", "field-unknown", "merge-queue-required", "unsupported-required-deployments", "unsupported-required-signatures", "unsupported-code-scanning", "unsupported-code-quality", "unsupported-file-restriction", "unsupported-metadata-restriction", "unsupported-active-rule", "unsupported-merge-method", "repository-unavailable", "pull-request-not-open", "draft", "fork", "controller-branch-unproven", "protected-surface", "path-not-allowed", "path-denied", "diff-limit-exceeded", "policy-unenforced", "independent-review-not-enforced", "merge-actor-can-bypass", "independent-review-missing", "changes-requested", "code-owner-review-missing", "unresolved-thread", "review-drift", "required-check-unproven", "required-check-pending", "required-check-failed", "unexpected-check-app", "check-sha-drift", "base-behind", "merge-conflict"]},
        "surface": {"type": "string", "minLength": 1, "maxLength": 256},
        "detail": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["context", "app_id"],
      "properties": {
        "context": {"type": "string", "minLength": 1, "maxLength": 100},
        "app_id": {"type": "integer", "minimum": 1}
      }
    }
  }
}
