{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathfinder.local/schemas/publication/merge-evidence-provenance.schema.json",
  "title": "Pathfinder Composed Merge Evidence Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance_id",
    "evidence_id",
    "evidence_sha256",
    "observer_credential_receipt_id",
    "observer_credential_receipt_sha256",
    "publication_receipt_id",
    "publication_receipt_sha256",
    "graphql_query_sha256",
    "reconciled_review_ids",
    "required_checks",
    "request_ids_sha256",
    "observed_at",
    "completed_at",
    "provenance_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provenance_id": {"type": "string", "pattern": "^merge_evidence_provenance_[a-z0-9][a-z0-9_-]{7,63}$"},
    "evidence_id": {"type": "string", "pattern": "^merge_evidence_[a-z0-9][a-z0-9_-]{7,63}$"},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "observer_credential_receipt_id": {"type": "string", "pattern": "^evidence_credential_receipt_[a-z0-9][a-z0-9_-]{7,63}$"},
    "observer_credential_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "publication_receipt_id": {"type": "string", "pattern": "^publication_receipt_[a-z0-9][a-z0-9_-]{7,63}$"},
    "publication_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "graphql_query_sha256": {"const": "dcb086d66394c7380a8933204c23d7aac3bde96762d05e69c5cc37edb770fdb5"},
    "reconciled_review_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/checkIdentity"}},
    "request_ids_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "provenance_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "app_id"],
      "properties": {
        "context": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()@,+-]{0,99}$"},
        "app_id": {"type": "integer", "minimum": 1}
      }
    }
  }
}
