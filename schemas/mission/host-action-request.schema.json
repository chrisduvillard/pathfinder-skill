{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathfinder.local/schemas/mission/host-action-request.schema.json",
  "title": "Pathfinder Host Action Request",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "action_id", "operation_id", "mission_id", "attempt_id", "action_kind", "request_sha256", "authorization_snapshot_sha256", "runtime_boundary_sha256", "context", "requested_at"],
  "properties": {
    "schema_version": {"const": 1},
    "action_id": {"type": "string", "pattern": "^action_[a-z0-9][a-z0-9_-]{7,63}$"},
    "operation_id": {"type": "string", "pattern": "^operation_[a-z0-9][a-z0-9_-]{7,63}$"},
    "mission_id": {"type": "string", "pattern": "^mission_[a-z0-9][a-z0-9_-]{7,63}$"},
    "attempt_id": {"type": "string", "pattern": "^attempt_[a-z0-9][a-z0-9_-]{7,63}$"},
    "action_kind": {"enum": ["prepare-worktree", "activate-goal", "implement", "verify", "commit", "publish"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_boundary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context": {"$ref": "#/$defs/context"},
    "requested_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "goal_id", "worktree_id", "input_sha256", "deadline_at", "protected_policy_sha256"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^binding_[a-z0-9][a-z0-9_-]{7,63}$"},
        "goal_id": {"type": ["string", "null"], "pattern": "^goal_[a-z0-9][a-z0-9_-]{7,63}$"},
        "worktree_id": {"type": ["string", "null"], "pattern": "^worktree_[a-z0-9][a-z0-9_-]{7,63}$"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deadline_at": {"type": "string", "format": "date-time"},
        "protected_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
